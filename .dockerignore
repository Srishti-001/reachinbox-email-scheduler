# Dependencies — rebuilt inside Docker for the target platform (Linux Alpine)
# Including local node_modules from Windows in the build context would overwrite
# the Linux-compatible ones installed by `npm ci`, causing runtime crashes.
**/node_modules

# Next.js build output — rebuilt from source inside Docker
**/.next

# Local environment files — secrets must never be copied into an image
**/.env
**/.env.*
!**/.env.example

# Git
.git
.gitignore
.gitattributes

# Editor / OS
.DS_Store
Thumbs.db
.vscode
.idea

# Logs
**/*.log
**/npm-debug.log*

# Test artifacts
**/coverage
**/.nyc_output

# Docker-specific files (not needed in image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Local dev scripts
RESTART_TEST.md
README.md
