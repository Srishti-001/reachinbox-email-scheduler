# Frontend Dockerfile - Next.js standalone output for reliable production deployment
FROM node:20-alpine AS builder

WORKDIR /app

# Copy frontend package files
COPY frontend/package*.json ./

# Install all dependencies (needed for build)
RUN npm ci

# Copy frontend source code
COPY frontend ./

# Build args passed in by Railway at build time
# NEXT_PUBLIC_* vars are embedded at compile time — must be declared here
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build Next.js with standalone output (set in next.config.mjs)
RUN npm run build

# Production stage — use the self-contained standalone server
# No npm ci required: .next/standalone bundles its own node_modules
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy the standalone server bundle
COPY --from=builder /app/.next/standalone ./

# Copy static assets (not included in standalone)
COPY --from=builder /app/.next/static ./.next/static

# Copy public directory
COPY --from=builder /app/public ./public

EXPOSE 3000

# Run the standalone Next.js server directly — no npm needed
CMD ["node", "server.js"]
